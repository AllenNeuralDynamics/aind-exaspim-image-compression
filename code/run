#!/usr/bin/env bash
set -euo pipefail

# ---------------------------------------------------------------------------
# Dispatcher: routes to train.py or evaluate.py based on --run_mode.
#
# App Panel parameters (named_parameters=true):
#   Run Configuration:   --run_mode      (Train | Evaluate)
#                        --dataset_name  (alpha | beta | beta2 | all)
#   Train Parameters:    --config_name   path stem of the JSON config in /data
#                        --model_name    (unet | n2v2_unet)
#   Evaluate Parameters: --crop_shape    e.g. "1024, 1024, 1024"
#                        --clevel        integer 1-9
#                        --top_k_ckpts   integer >= 1
# ---------------------------------------------------------------------------

run_mode=""
dataset_name=""
config_name=""
model_name=""
crop_shape=""
clevel=""
top_k_ckpts=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --run_mode)       run_mode="$2";         shift 2 ;;
        --run_mode=*)     run_mode="${1#*=}";     shift   ;;
        --dataset_name)   dataset_name="$2";      shift 2 ;;
        --dataset_name=*) dataset_name="${1#*=}"; shift   ;;
        --config_name)    config_name="$2";       shift 2 ;;
        --config_name=*)  config_name="${1#*=}";  shift   ;;
        --model_name)     model_name="$2";        shift 2 ;;
        --model_name=*)   model_name="${1#*=}";   shift   ;;
        --crop_shape)     crop_shape="$2";        shift 2 ;;
        --crop_shape=*)   crop_shape="${1#*=}";   shift   ;;
        --clevel)         clevel="$2";            shift 2 ;;
        --clevel=*)       clevel="${1#*=}";       shift   ;;
        --top_k_ckpts)    top_k_ckpts="$2";       shift 2 ;;
        --top_k_ckpts=*)  top_k_ckpts="${1#*=}";  shift   ;;
        *) echo "Error: unknown argument '$1'" >&2; exit 1 ;;
    esac
done

# Normalise to lower-case (bash 4+, standard on all CO instances)
run_mode="${run_mode,,}"

# --- Validate shared required params ---------------------------------------
[[ -n "$run_mode" ]]     || { echo "Error: --run_mode is required (train|evaluate)." >&2; exit 1; }
[[ -n "$dataset_name" ]] || { echo "Error: --dataset_name is required." >&2; exit 1; }

# --- Route -----------------------------------------------------------------
case "$run_mode" in
    train)
        [[ -n "$config_name" ]] || { echo "Error: --config_name is required for train mode." >&2; exit 1; }
        [[ -n "$model_name"  ]] || { echo "Error: --model_name is required for train mode." >&2; exit 1; }

        echo "[run] mode=train  dataset=${dataset_name}  config=${config_name}  model=${model_name}"

        python -u /code/train.py \
            --dataset_name "$dataset_name" \
            --config_name  "$config_name"  \
            --model_name   "$model_name"
        ;;

    eval|evaluate)
        echo "[run] mode=evaluate  dataset=${dataset_name}"

        eval_args=( --dataset_name "$dataset_name" )
        [[ -n "$crop_shape"  ]] && eval_args+=( --crop_shape  "$crop_shape"  )
        [[ -n "$clevel"      ]] && eval_args+=( --clevel      "$clevel"      )
        [[ -n "$top_k_ckpts" ]] && eval_args+=( --top_k_ckpts "$top_k_ckpts" )

        python -u /code/evaluate.py "${eval_args[@]}"
        ;;

    *)
        echo "Error: unknown run_mode '${run_mode}' — expected 'train' or 'evaluate'." >&2
        exit 1
        ;;
esac
